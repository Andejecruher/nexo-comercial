# Variables de infraestructura (compose prod/qa).
# Copiar a .env (produccion) o .env.qa (QA) y completar con secretos reales.
# En produccion/QA estas variables son OBLIGATORIAS: los compose fallan si faltan.

# ── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_USER=nexo
POSTGRES_PASSWORD=            # REQUERIDO en prod/qa (sin default inseguro)
POSTGRES_DB=nexocomercial      # QA sugerido: nexocomercial_qa

# ── Conexiones backend (api/worker/migrator) ───────────────────────────────
# REQUERIDAS en prod/qa. Deben apuntar a los servicios internos del stack.
DATABASE_URL=postgresql://nexo:CHANGE_ME@postgres:5432/nexocomercial

# Flag de rollout realtime (default true)
REALTIME_DURABLE_ENABLED=true

# ── Proxy Caddy (prod) ──────────────────────────────────────────────────────
CADDY_DOMAIN=

# ── QA: puertos host para Caddy (evitan colisiones con prod en el mismo host) ─
QA_HTTP_PORT=8080
QA_HTTPS_PORT=8443


# ── Correo transaccional / Mailtrap Email API ───────────────────────────────
MAIL_PROVIDER=mailtrap
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Nexo Comercial
MAILTRAP_API_TOKEN=
MAILTRAP_API_URL=
MAIL_SEND_TIMEOUT_MS=10000

# Endpoints administrativos de diagnóstico de correo (deshabilitados por defecto)
ENABLE_EMAIL_TEST_ENDPOINTS=false
EMAIL_TEST_ALLOWED_RECIPIENTS=
EMAIL_TEST_ALLOWED_DOMAINS=
EMAIL_TEST_RATE_LIMIT_MAX=5
EMAIL_TEST_RATE_LIMIT_WINDOW_SECONDS=600

# Presupuesto de campañas por número emisor (reserva capacidad para otros envíos)
CAMPAIGN_MESSAGES_PER_SECOND=5

# ── Capa de pruebas multimodales (independiente del agente) ──────────────────
# Habilita los endpoints internos de prueba (JWT + rol SUPER_ADMIN/COORDINADOR)
MULTIMODAL_TEST_ENABLED=true
# Presupuesto total por tipo de pipeline (ms)
MULTIMODAL_TEST_AUDIO_TIMEOUT_MS=120000
MULTIMODAL_TEST_DOCUMENT_TIMEOUT_MS=120000
MULTIMODAL_TEST_IMAGE_TIMEOUT_MS=60000
MULTIMODAL_TEST_VIDEO_TIMEOUT_MS=300000
# Reintentos por proveedor y espera entre reintentos
MULTIMODAL_TEST_MAX_RETRIES=1
MULTIMODAL_TEST_RETRY_DELAY_MS=100
# Tamaño máximo de archivo aceptado por los endpoints de prueba (MB)
MULTIMODAL_TEST_MAX_FILE_MB=25
