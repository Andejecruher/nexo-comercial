NODE_ENV=development
LOG_LEVEL=info
PORT=8000
WORKER_HEALTH_PORT=8010
CORS_ORIGIN=*

WS_ENABLED=true
WS_CORS_ORIGIN=
WS_PATH=/socket.io

DATABASE_URL=postgresql://voz:secret@postgres:5432/vozcuidadana

# Prisma pool size. Omit to default: 8 when WORKERS_ENABLED, otherwise 1.
# PRISMA_CONNECTION_LIMIT=8

WORKERS_ENABLED=true
# Set to true on request-driven Cloud Run workers. Cloud Scheduler invokes
# /tasks/cron/* endpoints, so no internal setInterval/setTimeout loop may run.
DISABLE_INTERNAL_POLLING=false
BACKGROUND_EXECUTION_BACKEND=polling
INBOX_POLL_INTERVAL_MS=2000
OUTBOX_POLL_INTERVAL_MS=1000
QUEUE_RETRY_PROMOTION_INTERVAL_MS=5000

# Polling loops split (solo aplica cuando BACKGROUND_EXECUTION_BACKEND=polling,
# i.e. dev local. En produccion cloud_tasks no tienen efecto).
# Por defecto ambos siguen a WORKERS_ENABLED. docker-compose.dev.yml los
# separa: api corre inbox (orquestador + WS gateway), worker corre outbox +
# INE OCR + exports. Asi el puente legacy eventBus -> socket funciona sin Pub/Sub.
# INBOX_POLLING_ENABLED=true
# OUTBOX_POLLING_ENABLED=true

# Cloud Tasks rollout. Required by both API (producer) and worker (handler)
# runtimes only when BACKGROUND_EXECUTION_BACKEND=cloud_tasks.
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
TASKS_QUEUE_NAME=background-tasks
WORKER_SERVICE_URL=
TASKS_SERVICE_ACCOUNT_EMAIL=
TASKS_RECONCILE_MAX_PER_TYPE=250

# Realtime durable outbox (rollout flag; defaults to true)
REALTIME_DURABLE_ENABLED=true

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_REFRESH_RATE_LIMIT_MAX=60
AUTH_REFRESH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATIONS=60,300,900,3600
AUTH_MAX_SESSIONS_PER_USER=5

PUBLIC_NEWSLETTER_RATE_LIMIT_MAX=20
PUBLIC_NEWSLETTER_RATE_LIMIT_WINDOW_SECONDS=900
NEWSLETTER_DOUBLE_OPT_IN=false
NEWSLETTER_CONFIRM_TTL_HOURS=72

PUBLIC_EVENTS_TZ=America/Mexico_City
PUBLIC_EVENTOS_SEMANA_RATE_LIMIT_MAX=120
PUBLIC_EVENTOS_SEMANA_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_EVENTOS_ASISTENCIA_RATE_LIMIT_MAX=15
PUBLIC_EVENTOS_ASISTENCIA_RATE_LIMIT_WINDOW_SECONDS=900

SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_FULL_NAME=

WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_ID=change-me
WHATSAPP_APP_SECRET=change-me
WHATSAPP_ACCESS_TOKEN=change-me
WHATSAPP_PHONE_NUMBER_ID=change-me
WHATSAPP_BUSINESS_ACCOUNT_ID=change-me

# Transactional email / Mailtrap (backend only; never expose with public frontend prefixes)
MAIL_PROVIDER=mailtrap
# Development/QA: Mailtrap Email Sandbox endpoint. Production: Mailtrap Sending API endpoint.
MAILTRAP_API_URL=
MAILTRAP_API_TOKEN=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Voz Ciudadana
MAIL_REPLY_TO_ADDRESS=
MAIL_SUPPORT_EMAIL=
MAIL_PLATFORM_NAME=Voz Ciudadana
# Fallback del logo si el cliente bloquea el adjunto inline. Vacío = {FRONTEND_URL}/images/email-logo.png
MAIL_LOGO_URL=
MAIL_TIME_ZONE=America/Mexico_City
MAIL_SEND_TIMEOUT_MS=10000
# WhatsApp media archive (API and worker use the same bucket and ADC as OCR).
GCS_MEDIA_BUCKET=voz_ciudadana
# Public campaign media bucket (uniform bucket-level access; no object ACLs).
GCS_PUBLIC_BUCKET=voz_ciudadana_public
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
# INE OCR / Google (optional until INE_OCR_ENABLED=true)
INE_OCR_ENABLED=false
GOOGLE_CLOUD_PROJECT_ID=
DOCUMENT_AI_LOCATION=
DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# XLSX export (optional until ENABLE_XLSX_EXPORT=true).
# Local polling: the worker picks up queued jobs without Cloud Tasks.
# Production sets ENABLE_XLSX_EXPORT=true on Cloud Run (cloud_tasks).
ENABLE_XLSX_EXPORT=false
# EXPORT_JOB_TTL_MS=86400000
# EXPORT_JOB_POLL_INTERVAL_MS=2000
# EXPORT_RECONCILE_INTERVAL_MS=3600000
# EXPORT_BATCH_SIZE=1000
# EXPORT_STREAM_HIGH_WATER_MARK=262144
# EXPORT_WATCHDOG_TIMEOUT_MS=900000
# EXPORT_FOLDER_CACHE_TTL_MS=3600000
# EXPORT_DOWNLOAD_TOKEN_TTL_MS=600000

FRONTEND_URL=http://localhost:5173
INVITATION_EXPIRATION_MINUTES=1440
INVITATION_RESEND_COOLDOWN_SECONDS=300
PASSWORD_RESET_EXPIRATION_MINUTES=60
PASSWORD_RESET_COOLDOWN_SECONDS=60

# Caché local de media de WhatsApp. Los bytes durables viven en GCS:
# esta copia solo cubre el turno en curso y se poda por antigüedad y tamaño.
# Por defecto: <directorio de trabajo>/storage/whatsapp. Nunca servir estáticamente.
# API y worker deben compartir el mismo volumen.
# WHATSAPP_MEDIA_DIR=/app/storage/whatsapp
# Retención máxima de una entrada (por defecto 7 días).
# WHATSAPP_MEDIA_CACHE_TTL_MS=604800000
# Tope de bytes del volumen (por defecto 256 MiB).
# WHATSAPP_MEDIA_CACHE_MAX_BYTES=268435456
# Messaging Graph version (messages and media share the same version).
# Confirm supported versions for your Meta application before deployment.
META_API_VERSION=v23.0
# Existing template catalog version may be configured separately.
META_TEMPLATES_API_VERSION=v23.0
# NVIDIA — chat/vision por HTTP y audio en Riva alojado; no incluir llaves reales.
NVIDIA_API_KEY=
# Conformer CTC en español: no requiere desplegar servicios propios.
NVIDIA_RIVA_FUNCTION_ID=71203149-d3b7-4460-8231-1be2543a1fca
NVIDIA_RIVA_LANGUAGE_CODE=es-US
NVIDIA_MULTIMODAL_TIMEOUT_MS=10000
