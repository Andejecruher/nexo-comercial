{
  "name": "nexo-comercial-api",
  "version": "0.1.0",
  "description": "Nexo Comercial — Express backend (WhatsApp bot + Prisma + FSM)",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --ignore-watch node_modules --ignore-watch dist --ignore-watch logs src/server.ts",
    "dev:api": "ts-node-dev --respawn --transpile-only --ignore-watch node_modules --ignore-watch dist --ignore-watch logs src/server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only --ignore-watch node_modules --ignore-watch dist --ignore-watch logs src/worker.ts",
    "dev:realtime-relay": "ts-node-dev --respawn --transpile-only --ignore-watch node_modules --ignore-watch dist --ignore-watch logs src/realtime-relay.ts",
    "worker": "ts-node-dev --respawn --transpile-only --ignore-watch node_modules --ignore-watch dist --ignore-watch logs src/worker.ts",
    "build": "tsc && node scripts/copy-runtime-assets.mjs",
    "start": "node dist/server.js",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=6144 eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "cross-env NODE_OPTIONS=--max-old-space-size=6144 eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=6144\" jest --runInBand",
    "test:watch": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=6144\" jest --watch",
    "test:postgres": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=6144\" jest --config=jest.postgres.config.js --runInBand",
    "test:docker": "docker compose --profile test run --rm api-test",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:migrate:prod": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "prisma:seed": "ts-node --project prisma/seed/tsconfig.json prisma/seed/index.ts",
    "prisma:seed:core": "ts-node --project prisma/seed/tsconfig.json prisma/seed/index.ts core",
    "prisma:seed:dev": "ts-node --project prisma/seed/tsconfig.json prisma/seed/index.ts dev",
    "prisma:seed:ai": "ts-node --project prisma/seed/tsconfig.json prisma/seed/index.ts dev",
    "prisma:seed:all": "ts-node --project prisma/seed/tsconfig.json prisma/seed/index.ts all",
    "prisma:seed:test": "ts-node --project prisma/seed/tsconfig.json prisma/seed/index.ts test",
    "prisma:studio": "prisma studio --schema=./prisma/schema.prisma",
    "generate:drive-token": "ts-node --project scripts/tsconfig.json scripts/driver/generate-token-drive.ts",
    "departments:repair-slugs": "ts-node --project scripts/tsconfig.json scripts/migrations/repair-department-slugs.ts",
    "diagnose:riva": "ts-node --transpile-only --project scripts/tsconfig.json scripts/diagnostics/riva-stt-diagnose.ts",
    "postinstall": "prisma generate --schema=./prisma/schema.prisma",
    "prepare": "node -e \"process.exit(require('fs').existsSync('node_modules/.bin/husky') ? 0 : 1)\" && husky install || true",
    "start:realtime-relay": "node dist/realtime-relay.js",
    "media:migrate:gcs": "node scripts/migrations/drive-media-to-gcs.mjs"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^6.0.1",
    "@google-cloud/storage": "^8.4.0",
    "@google-cloud/tasks": "^6.3.0",
    "@googleapis/drive": "^22.0.0",
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@prisma/client": "5.22.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@socket.io/gcp-pubsub-adapter": "^0.1.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "file-type": "21.3.2",
    "google-auth-library": "^10.9.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mailtrap": "^4.7.0",
    "nodemailer": "^9.0.3",
    "openai": "^6.35.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@jest/globals": "^29.7.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.2",
    "prettier": "^3.0.0",
    "prisma": "5.22.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "prisma": {
    "schema": "./prisma/schema.prisma",
    "seed": "ts-node --project prisma/seed/tsconfig.json prisma/seed/index.ts"
  }
}
