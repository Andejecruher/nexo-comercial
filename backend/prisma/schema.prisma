generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceChannel {
  whatsapp
  web
  event
  referral
  other

  @@map("source_channel")
}

enum ExportModule {
  promoted
  leaders
  coordinators
  citizens

  @@map("export_module")
}

enum ExportJobStatus {
  queued
  processing
  ready
  failed
  expired

  @@map("export_job_status")
}

enum LeadStatus {
  new
  contacted
  engaged
  converted
  unsubscribed

  @@map("lead_status")
}

/// Estado de la entidad Conversación (vida continua del canal con el ciudadano).
/// NO se cierra cuando se cierra un ticket: los tickets se cierran por caso y la
/// conversación permanece 'open' (reutilizable) hasta un cierre manual del agente
/// o por inactividad (cron). La FSM del flujo vive en ConversationMeta.
enum ConversationStatus {
  open
  in_progress
  resolved
  closed

  @@map("conversation_status")
}

enum ConversationChannel {
  whatsapp
  web_chat
  email
  sms
  other

  @@map("conversation_channel")
}

enum AttendanceMode {
  bot
  human

  @@map("attendance_mode")
}

enum MessageDirection {
  inbound
  outbound

  @@map("message_direction")
}

enum MessageType {
  text
  image
  audio
  video
  document
  location
  template
  interactive
  sticker
  contacts
  unsupported
  system

  @@map("message_type")
}

enum UserInvitationStatus {
  pending
  sent
  failed
  accepted
  expired
  revoked

  @@map("user_invitation_status")
}

model User {
  campaigns Campaign[]
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique @db.VarChar(255)
  hashedPassword String   @map("hashed_password") @db.VarChar(255)
  fullName       String?  @map("full_name") @db.VarChar(255)
  phone          String?  @db.VarChar(30)
  isActive       Boolean  @default(true) @map("is_active")
  isSuperuser    Boolean  @default(false) @map("is_superuser")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles      UserRole[]
  invitations    UserInvitation[]
  passwordResets PasswordReset[]
  coordinator    Coordinator? @relation("CoordinatorUser")
  leader         Leader?      @relation("LeaderUser")
  refreshSessions RefreshSession[]

  auditLogs AuditLog[] @relation("AuditLogActor")

  assignedConversations Conversation[] @relation("ConversationAssignedUser")
  assignedCitizenTags   CitizenTag[]   @relation("CitizenTagAssignedBy")
  uploadedAttachments   Attachment[]   @relation("AttachmentUploadedBy")
  assignments           Assignment[]   @relation("AssignmentUser")
  organizedEvents       Event[]        @relation("EventOrganizer")
  eventCheckins         EventCheckin[] @relation("EventCheckinByUser")
  assignedTickets       Ticket[]       @relation("TicketAssignedUser")
  createdUploads        UploadRecord[] @relation("UploadCreatedBy")
  reviewedUploads       UploadRecord[] @relation("UploadReviewedBy")
  createdPromovidos     Promovido[]    @relation("PromovidoCreatedBy")
  sentMessages          Message[]      @relation("MessageSendBy")
  conversationReads     ConversationRead[] @relation("ConversationReadUser")
  notificationPreferences UserNotificationPreference? @relation("UserNotificationPreferences")

  @@index([email])
  @@map("users")
}

model UserNotificationPreference {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  preferences   Json     @map("preferences") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation("UserNotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_notification_preferences")
}

model ExportJob {
  id                String          @id @default(uuid()) @db.Uuid
  module            ExportModule    @map("module")
  filtersJson       Json            @default("{}") @map("filters_json") @db.JsonB
  scopeSnapshot     Json            @map("scope_snapshot") @db.JsonB
  status            ExportJobStatus @default(queued)
  driveFileId       String?         @map("drive_file_id") @db.VarChar(255)
  /// Relative GCS object name. Signed URLs are generated only for HTTP responses.
  filePath          String?         @map("file_path") @db.Text
  driveFolderId     String?         @map("drive_folder_id") @db.VarChar(255)
  driveFilename     String?         @map("drive_filename") @db.VarChar(255)
  downloadTokenHash      String?    @map("download_token_hash") @db.VarChar(64)
  downloadTokenExpiresAt DateTime?  @map("download_token_expires_at") @db.Timestamptz(6)
  downloadTokenConsumedAt DateTime? @map("download_token_consumed_at") @db.Timestamptz(6)
  rowCount          Int?            @map("row_count")
  errorCode         String?         @map("error_code") @db.VarChar(80)
  lastError         String?         @map("last_error") @db.Text
  requestedByUserId String          @map("requested_by_user_id") @db.Uuid
  requestedAt       DateTime        @default(now()) @map("requested_at") @db.Timestamptz(6)
  expiresAt         DateTime        @map("expires_at") @db.Timestamptz(6)
  completedAt       DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([requestedByUserId, createdAt])
  @@index([status, expiresAt])
  @@index([status, completedAt])
  @@map("export_jobs")
}

model UserInvitation {
  id                   String               @id @default(uuid()) @db.Uuid
  userId               String               @map("user_id") @db.Uuid
  tokenHash            String               @map("token_hash") @db.VarChar(128)
  status               UserInvitationStatus @default(pending)
  expiresAt            DateTime             @map("expires_at") @db.Timestamptz(6)
  sentAt               DateTime?            @map("sent_at") @db.Timestamptz(6)
  acceptedAt           DateTime?            @map("accepted_at") @db.Timestamptz(6)
  revokedAt            DateTime?            @map("revoked_at") @db.Timestamptz(6)
  provider             String?              @db.VarChar(40)
  providerMessageId    String?              @map("provider_message_id") @db.VarChar(255)
  lastErrorCode        String?              @map("last_error_code") @db.VarChar(80)
  deliveryAttemptCount Int                  @default(0) @map("delivery_attempt_count")
  createdById          String?              @map("created_by_id") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash], map: "uq_user_invitations_token_hash")
  @@index([userId, status])
  @@index([expiresAt])
  @@map("user_invitations")
}

/// Token de restablecimiento de contraseña. Se guarda solo el hash SHA-256;
/// el token en claro únicamente viaja en el correo.
model PasswordReset {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @map("token_hash") @db.VarChar(128)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(6)
  requestedIp   String?   @map("requested_ip") @db.VarChar(45)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash], map: "uq_password_resets_token_hash")
  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  slug        String   @unique @db.VarChar(80)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([name])
  @@index([slug])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  module      String   @db.VarChar(80)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@index([module])
  @@index([slug])
  @@index([isActive])
  @@index([isSystem])
  @@map("permissions")
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId], map: "uq_user_roles_user_role")
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Neighborhood {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  matchKey     String   @map("match_key") @db.VarChar(255)
  sectionId    String?  @map("section_id") @db.Uuid
  zone         String?  @db.VarChar(100)
  postalCode   String?  @map("postal_code") @db.VarChar(10)
  municipality String?  @db.VarChar(100)
  state        String   @default("Chiapas") @db.VarChar(100)
  stateCode    String   @default("CHP") @map("state_code") @db.VarChar(5)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  citizens Citizen[]
  leaders  Leader[]
  section  Section?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([sectionId, matchKey, municipality], map: "uq_neighborhoods_section_match_key")
  @@index([name])
  @@index([sectionId])
  @@index([postalCode])
  @@index([municipality])
  @@index([state])
  @@map("neighborhoods")
}

model Citizen {
  campaignRecipients CampaignRecipient[]
  id                  String        @id @default(uuid()) @db.Uuid
  phone               String?       @unique @db.VarChar(30)
  voterKeyFingerprint String?       @unique @map("voter_key_fingerprint") @db.VarChar(32)
  curpFingerprint     String?       @unique @map("curp_fingerprint") @db.VarChar(32)
  name                String?       @db.VarChar(255)
  lastName            String?       @map("last_name") @db.VarChar(255)
  email               String?       @db.VarChar(255)
  sourceChannel       SourceChannel @default(whatsapp) @map("source_channel")
  leadStatus          LeadStatus    @default(new) @map("lead_status")
  consentGiven        Boolean       @default(false) @map("consent_given")
  consentAt           DateTime?     @map("consent_at") @db.Timestamptz(6)
  neighborhood        String?       @db.VarChar(255)
  neighborhoodId      String?       @map("neighborhood_id") @db.Uuid
  interests           String[]      @default([]) @db.Text
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  neighborhoodRef Neighborhood? @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)

  conversations      Conversation[]
  citizenTags        CitizenTag[]
  attachments        Attachment[]
  eventRegistrations EventRegistration[]
  aiRuns             AiRun[]
  tickets            Ticket[]
  promovido          Promovido?

  @@index([phone])
  @@index([voterKeyFingerprint])
  @@index([curpFingerprint])
  @@index([email])
  @@map("citizens")
}

/// Conversación = entidad continua por ciudadano (historial completo del canal).
/// Un ciudadano mantiene UNA conversación canónica de por vida: si llega con una
/// FSM CLOSED o status no-open, la próxima interacción la reactiva (CLOSED→BOT_FLOW)
/// en lugar de crear otra. Los tickets (1:N vía `tickets`) agrupan los trámites
/// por caso. La semántica operativa del inbox ("Activa/Inactiva") se resuelve por
/// tickets activos (OPEN | IN_PROGRESS), no por `status`.
model Conversation {
  /// Indexed conversation scope; synchronized with meta by a database trigger.
  communicationLineId String? @map("communication_line_id") @db.Uuid
  realtimeVersion Int                 @default(0) @map("realtime_version")
  id             String              @id @default(uuid()) @db.Uuid
  citizenId      String              @map("citizen_id") @db.Uuid
  status         ConversationStatus  @default(open)
  channel        ConversationChannel @default(whatsapp)
  isCanonical    Boolean             @default(true) @map("is_canonical")
  assignedDept   String?             @map("assigned_dept") @db.VarChar(100)
  assignedUserId String?             @map("assigned_user_id") @db.Uuid
  /// Quién atiende la conversación: bot (IA activa) o human (agente/departamento).
  /// Fuente de verdad para silenciar la IA, independiente de flowState.
  attendanceMode AttendanceMode      @default(bot) @map("attendance_mode")
  /// Kill-switch operativo del bot por conversación. false silencia la IA.
  botEnabled     Boolean             @default(true) @map("bot_enabled")
  /// Trazabilidad del último handoff a departamento (auditoría + alertas de
  /// handoffs que quedaron con la IA activa).
  transferredAt  DateTime?           @map("transferred_at") @db.Timestamptz(6)
  transferredBy  String?             @map("transferred_by") @db.VarChar(100)
  transferReason String?             @map("transfer_reason") @db.VarChar(255)
  /// Ticket abierto actualmente (OPEN | IN_PROGRESS). null si no hay ninguno.
  /// Denormalización de uq_tickets_one_active_per_conversation para lectura directa.
  activeTicketId String?             @map("active_ticket_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  citizen Citizen @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  assignedUser User? @relation("ConversationAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  activeTicket Ticket? @relation("ConversationActiveTicket", fields: [activeTicketId], references: [id], onDelete: SetNull)

  messages    Message[]
  assignments Assignment[]
  meta        ConversationMeta?
  aiRuns      AiRun[]
  tickets     Ticket[]
  reads       ConversationRead[] @relation("ConversationReadConversation")

  @@index([transferredAt])
  @@index([assignedUserId])
  @@index([citizenId, status])
  @@index([activeTicketId])
  @@map("conversations")
}

model ConversationRead {
  userId         String   @map("user_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  lastReadAt     DateTime @map("last_read_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation("ConversationReadUser", fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation("ConversationReadConversation", fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([userId, conversationId])
  @@index([conversationId])
  @@map("conversation_reads")
}

model Message {
  id                String           @id @default(uuid()) @db.Uuid
  conversationId    String           @map("conversation_id") @db.Uuid
  /// Ticket al que pertenece el mensaje. Fuente de lectura para la vista de detalle
  /// por ticket. Nullable a nivel DB solo por mensajes históricos; la capa de
  /// aplicación garantiza que todo mensaje nuevo tenga ticket.
  ticketId          String?          @map("ticket_id") @db.Uuid
  body              String           @db.Text
  direction         MessageDirection
  messageType       MessageType      @default(text) @map("message_type")
  externalMessageId String?          @map("external_message_id") @db.VarChar(255)
  idempotencyKey   String?          @unique @map("idempotency_key") @db.VarChar(255)
  attachmentId      String?          @map("attachment_id") @db.Uuid
  sendByUserId      String?          @map("send_by_user_id") @db.Uuid
  meta              Json             @default("{}") @db.JsonB
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  ticket Ticket? @relation("MessageTicket", fields: [ticketId], references: [id], onDelete: SetNull)

  sender User? @relation("MessageSendBy", fields: [sendByUserId], references: [id], onDelete: SetNull)

  attachment Attachment? @relation("MessageAttachmentByAttachmentId", fields: [attachmentId], references: [id], onDelete: SetNull)

  attachmentsViaMessageId Attachment[]    @relation("AttachmentBelongsToMessage")
  statuses                MessageStatus[]
  ticketMessages          TicketMessage[] @relation("MessageTickets")

  @@index([conversationId, createdAt, id])
  @@index([conversationId, direction, createdAt])
  @@index([ticketId, createdAt, id])
  @@index([externalMessageId])
  @@index([sendByUserId])
  @@index([ticketId])
  @@map("messages")
}

model Attachment {
  communicationLineId String? @map("communication_line_id") @db.Uuid
  checksumMd5 String? @map("checksum_md5") @db.VarChar(32)
  providerMediaId String? @map("provider_media_id") @db.VarChar(255)
  providerPhoneNumberId String? @map("provider_phone_number_id") @db.VarChar(100)
  processingState String @default("legacy") @map("processing_state") @db.VarChar(24)
  driveFileId String? @map("drive_file_id") @db.VarChar(255)
  driveFolderId String? @map("drive_folder_id") @db.VarChar(255)
  checksumSha256 String? @map("checksum_sha256") @db.VarChar(64)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lockedAt DateTime? @map("locked_at") @db.Timestamptz(6)
  lastErrorCode String? @map("last_error_code") @db.VarChar(80)
  storedAt DateTime? @map("stored_at") @db.Timestamptz(6)

  id               String   @id @default(uuid()) @db.Uuid
  /// Relative GCS name: conversations/<line>/<conversation>/<filename>. Pending rows may contain a Meta media ID.
  storageKey       String   @map("storage_key") @db.VarChar(1024)
  mimeType         String   @map("mime_type") @db.VarChar(127)
  fileSizeBytes    BigInt   @map("file_size_bytes")
  originalFilename String?  @map("original_filename") @db.VarChar(512)
  cdnUrl           String?  @map("cdn_url") @db.Text
  messageId        String?  @map("message_id") @db.Uuid
  citizenId        String?  @map("citizen_id") @db.Uuid
  uploadedBy       String?  @map("uploaded_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message Message? @relation("AttachmentBelongsToMessage", fields: [messageId], references: [id], onDelete: SetNull)

  citizen  Citizen? @relation(fields: [citizenId], references: [id], onDelete: SetNull)
  uploader User?    @relation("AttachmentUploadedBy", fields: [uploadedBy], references: [id], onDelete: SetNull)

  messagesViaAttachmentId Message[] @relation("MessageAttachmentByAttachmentId")

  @@index([messageId])
  @@index([citizenId])
  @@unique([messageId, providerMediaId])
  @@index([providerMediaId])
  @@index([processingState, nextAttemptAt])
  @@map("attachments")
}

model Tag {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  color       String?  @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  citizenTags CitizenTag[]

  @@index([name])
  @@map("tags")
}

// ── Auditoría de acciones administrativas ─────────────────────────────────────

/// Registro inmutable de acciones sensibles realizadas por usuarios admin.
/// No se eliminan ni modifican — append-only por diseño.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid // null si la acción fue del sistema
  action     String   @db.VarChar(100) // ej: "user.create", "user.deactivate"
  targetType String   @map("target_type") @db.VarChar(50) // ej: "User", "Role"
  targetId   String?  @map("target_id") @db.VarChar(255)
  metadata   Json     @default("{}") @db.JsonB // datos adicionales de la acción
  ip         String?  @db.VarChar(45) // IPv4 o IPv6
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

model CitizenTag {
  id           String   @id @default(uuid()) @db.Uuid
  citizenId    String   @map("citizen_id") @db.Uuid
  tagId        String   @map("tag_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  citizen Citizen @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  assignedBy User? @relation("CitizenTagAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([citizenId, tagId], map: "uq_citizen_tags_citizen_tag")
  @@index([citizenId])
  @@index([tagId])
  @@map("citizen_tags")
}

// ── Messaging Core ────────────────────────────────────────────────────────────

enum ConversationFlowState {
  BOT_FLOW
  REGISTERING
  DEPARTMENT_ROUTING
  HUMAN_FLOW
  ESCALATED
  CLOSED

  @@map("conversation_flow_state")
}

enum MessageStatusValue {
  sent
  delivered
  read
  failed

  @@map("message_status_value")
}

enum InboxEventStatus {
  pending
  processing
  processed
  failed
  dead_lettered

  @@map("inbox_event_status")
}

enum OutboxEventStatus {
  pending
  sending
  sent
  failed
  dead_lettered

  @@map("outbox_event_status")
}

enum RealtimeOutboxStatus {
  pending
  publishing
  published
  failed
  dead_lettered

  @@map("realtime_outbox_status")
}

enum AIProvider {
  openai
  anthropic

  @@map("ai_provider")
}

enum AIToolKind {
  internal
  external

  @@map("ai_tool_kind")
}

enum AIPromptType {
  system
  tool
  topic
  fallback

