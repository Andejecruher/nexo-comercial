  whatsappAppSecret         String?             @map("whatsapp_app_secret") @db.VarChar(255)
  whatsappAccessToken       String?             @map("whatsapp_access_token") @db.Text
  whatsappBusinessAccountId String?             @map("whatsapp_business_account_id") @db.VarChar(100)
