  topics                   AiAgentTopic[]
  communicationLines       CommunicationLine[] @relation("CommunicationLineAgent")
  legacyCommunicationLines CommunicationLine[] @relation("CommunicationLineLegacyAgent")
  aiRuns                   AiRun[]

  @@index([isActive])
