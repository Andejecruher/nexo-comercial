  dataEncrypted        String   @map("data_encrypted") @db.Text
  stateNameSnapshot    String   @map("state_name_snapshot") @db.VarChar(120)
  districtCodeSnapshot String   @map("district_code_snapshot") @db.VarChar(20)
  sectionCodeSnapshot  String   @map("section_code_snapshot") @db.VarChar(20)
  leaderNameSnapshot   String   @map("leader_name_snapshot") @db.VarChar(255)
  isActive             Boolean  @default(true) @map("is_active")
  // Privacy-preserving deterministic fingerprints for searching and enforcing uniqueness.
  voterKeyFingerprint  String?  @map("voter_key_fingerprint") @db.VarChar(32)
  curpFingerprint      String?  @map("curp_fingerprint") @db.VarChar(32)
  phoneFingerprint     String?  @map("phone_fingerprint") @db.VarChar(32)
  // Blind index of the encrypted `sex` field so it can be filtered in SQL.
  sexBlindIndex        String?  @map("sex_blind_index") @db.VarChar(64)
  nameSearchTokens     String[] @default([]) @map("name_search_tokens") @db.Text
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  uploadRecord UploadRecord? @relation(fields: [uploadRecordId], references: [id], onDelete: Restrict)
  leader       Leader        @relation(fields: [leaderId], references: [id], onDelete: Restrict)
  section      Section       @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  citizen      Citizen?      @relation(fields: [citizenId], references: [id], onDelete: Restrict)
  createdBy    User          @relation("PromovidoCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([voterKeyFingerprint], map: "uq_promovidos_voter_key_fingerprint")
  @@index([leaderId, createdAt])
  @@index([sectionId, createdAt])
  @@index([isActive, createdAt])
  @@index([curpFingerprint])
  @@index([phoneFingerprint])
  @@index([sexBlindIndex])
  @@index([nameSearchTokens])
  @@map("promovidos")
}

enum GoalScope {
  GLOBAL
  SECTION
  LEADER

  @@map("goal_scope")
}

enum GoalCadence {
  CAMPAIGN
  MONTHLY
  WEEKLY

  @@map("goal_cadence")
}

model PrecampaignGoal {
  id        String      @id @default(uuid()) @db.Uuid
  title     String      @db.VarChar(100)
  target    Int
  scope     GoalScope   @default(GLOBAL)
  cadence   GoalCadence @default(WEEKLY)
  sectionId String?     @map("section_id") @db.Uuid
  leaderId  String?     @map("leader_id") @db.Uuid
  startDate DateTime    @map("start_date") @db.Timestamptz(6)
  endDate   DateTime    @map("end_date") @db.Timestamptz(6)
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  section Section? @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  leader  Leader?  @relation(fields: [leaderId], references: [id], onDelete: Restrict)

  @@index([scope, cadence, isActive, startDate, endDate], map: "idx_precampaign_goals_scope_cadence_dates")
  @@index([sectionId, cadence, isActive, startDate, endDate], map: "idx_precampaign_goals_section_cadence_dates")
  @@index([leaderId, cadence, isActive, startDate, endDate], map: "idx_precampaign_goals_leader_cadence_dates")
  @@map("precampaign_goals")
}

/// Sesiones de refresh token multi-dispositivo (reemplaza el storage Redis).
/// Cada fila es una sesión identificada por {userId, deviceId, jti}.
model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String    @map("device_id") @db.VarChar(255)
  jti       String    @db.VarChar(64)
  tokenHash String    @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, deviceId, jti])
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

/// Contadores atómicos de rate limiting (ventana fija) sobre PostgreSQL.
/// Una fila por (scope, bucketKey, windowStart); upsert ON CONFLICT.
model RateLimitCounter {
  scope       String   @db.VarChar(50)
  bucketKey   String   @map("bucket_key") @db.VarChar(255)
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([scope, bucketKey, windowStart])
  @@index([scope, windowStart])
  @@map("rate_limit_counters")
}

/// Estado de lockout progresivo por identidad (email/phone/IP) sobre PostgreSQL.
model IdentityLockout {
  id            String    @id @default(uuid()) @db.Uuid
  identityKey   String    @unique @map("identity_key") @db.VarChar(255)
  fails         Int       @default(0)
  level         Int       @default(0)
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(6)
  lastFailureAt DateTime? @map("last_failure_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([lockedUntil])
  @@map("identity_lockouts")
}

// Durable, WABA-scoped SSE log; shared by all API instances.
model TemplateStatusEvent {
  id           BigInt   @id @default(autoincrement())
  dedupeKey    String   @unique @map("dedupe_key") @db.VarChar(64)
  wabaId       String   @map("waba_id") @db.VarChar(100)
  templateId   String   @map("template_id") @db.VarChar(100)
  templateName String   @map("template_name") @db.VarChar(512)
  status       String   @db.VarChar(100)
  reason       String?
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(6)
  receivedAt   DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  @@index([wabaId, id])
  @@map("template_status_events")
}

model ManagedTemplate {
  templateId String @id @map("template_id") @db.VarChar(100)
  wabaId String @map("waba_id") @db.VarChar(100)
  createdAt DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)
  @@index([wabaId])
  @@map("managed_templates")
}

enum CampaignStatus {
  queued
  running
  completed
  needs_review
}

enum CampaignMessageStatus {
  pending
  sent
  delivered
  read
  failed
}

enum CampaignDispatchState {
  queued
  sending
  accepted
  finished
  uncertain
}

model Campaign {
  attachment CampaignAttachment?
  id               String         @id @default(uuid()) @db.Uuid
  name             String         @db.VarChar(160)
  purpose          String         @db.VarChar(1000)
  lineId           String         @map("line_id") @db.Uuid
  phoneNumberId    String         @map("phone_number_id") @db.VarChar(100)
  templateId       String         @map("template_id") @db.VarChar(100)
  templateSnapshot Json           @map("template_snapshot") @db.JsonB
  mappings         Json           @db.JsonB
  source           String         @db.VarChar(20)
  status           CampaignStatus @default(queued)
  total            Int
  createdBy        String         @map("created_by") @db.Uuid
  idempotencyKey   String         @map("idempotency_key") @db.Uuid
  requestHash      String         @map("request_hash") @db.VarChar(64)
  consentConfirmedAt DateTime     @map("consent_confirmed_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  recipients       CampaignRecipient[]
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  line CommunicationLine @relation(fields: [lineId], references: [id], onDelete: Restrict)

  @@unique([createdBy, idempotencyKey])
  @@index([createdAt, id])
  @@index([status, createdAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id              String                @id @default(uuid()) @db.Uuid
  campaignId      String                @map("campaign_id") @db.Uuid
  citizenId       String?               @map("citizen_id") @db.Uuid
  phone           String                @db.VarChar(16)
  // Resolved at creation: edits to CSV/citizen data cannot change a queued send.
  variables       Json                  @db.JsonB
  messageId       String?               @unique @map("message_id") @db.VarChar(512)
  status          CampaignMessageStatus @default(pending)
  dispatchState   CampaignDispatchState @default(queued) @map("dispatch_state")
  attempts        Int                   @default(0)
  nextAttemptAt   DateTime              @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lockedAt        DateTime?             @map("locked_at") @db.Timestamptz(6)
  errorCode       String?               @map("error_code") @db.VarChar(80)
  acceptedAt      DateTime?             @map("accepted_at") @db.Timestamptz(6)
  sentAt          DateTime?             @map("sent_at") @db.Timestamptz(6)
  deliveredAt     DateTime?             @map("delivered_at") @db.Timestamptz(6)
  readAt          DateTime?             @map("read_at") @db.Timestamptz(6)
  failedAt        DateTime?             @map("failed_at") @db.Timestamptz(6)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  campaign        Campaign              @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  citizen Citizen? @relation(fields: [citizenId], references: [id], onDelete: SetNull)

  @@unique([campaignId, phone])
  @@index([campaignId, status])
  @@index([campaignId, dispatchState, nextAttemptAt])
  @@map("campaign_recipients")
}

// Uploads are owned and scoped before campaign creation; only this file is public.
model CampaignAttachment {
  id         String    @id @default(uuid()) @db.Uuid
  createdBy  String    @map("created_by") @db.Uuid
  lineId     String    @map("line_id") @db.Uuid
  templateId String    @map("template_id") @db.VarChar(100)
  fileId     String    @unique @map("file_id") @db.Text
  folderId   String    @map("folder_id") @db.Text
  filename   String    @db.VarChar(255)
  mimeType   String    @map("mime_type") @db.VarChar(100)
  mediaType  String    @map("media_type") @db.VarChar(20)
  url        String    @db.Text
  viewUrl    String    @map("view_url") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  campaignId String?   @unique @map("campaign_id") @db.Uuid
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@index([createdBy, createdAt])
  @@map("campaign_attachments")
}

// Durable administrative queue. Items are claimed before invoking domain services.
model ConversationBulkJob {
  id          String                 @id @default(uuid()) @db.Uuid
  actorId     String                 @db.Uuid
  requestKey  String                 @db.Uuid
  payloadHash String
  payload     Json
  createdAt   DateTime               @default(now()) @db.Timestamptz(6)
  items       ConversationBulkItem[]

  @@unique([actorId, requestKey])
  @@map("conversation_bulk_jobs")
}

model ConversationBulkItem {
  id             String              @id @default(uuid()) @db.Uuid
  jobId          String              @db.Uuid
  conversationId String              @db.Uuid
  status         String              @default("pending")
  error          String?
  claimedAt      DateTime?           @db.Timestamptz(6)
  job            ConversationBulkJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, conversationId])
  @@index([status, claimedAt])
  @@map("conversation_bulk_items")
}
