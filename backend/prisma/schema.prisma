/// Extiende Conversation con estado de la máquina de estados de orquestación.
/// Se agrega como modelo separado para no romper el modelo Conversation existente.
model ConversationMeta {
  id                  String                @id @default(uuid()) @db.Uuid
  conversationId      String                @unique @map("conversation_id") @db.Uuid
  communicationLineId String?               @map("communication_line_id") @db.Uuid
  flowState           ConversationFlowState @default(BOT_FLOW) @map("flow_state")
  lockedByUserId      String?               @map("locked_by_user_id") @db.Uuid
  lockedAt            DateTime?             @map("locked_at") @db.Timestamptz(6)
  version             Int                   @default(0) // optimistic locking
  fsmLockToken        String?               @map("fsm_lock_token") @db.VarChar(64)
  fsmLockedAt         DateTime?             @map("fsm_locked_at") @db.Timestamptz(6)
  departmentSlug      String?               @map("department_slug") @db.VarChar(100)
  handoverAt          DateTime?             @map("handover_at") @db.Timestamptz(6)
  /// Trazabilidad del último handoff (escalate | agent_transfer | manual_handover | rule_handover | department_transfer | to_ai).
  handoffKind         String?               @map("handoff_kind") @db.VarChar(50)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  conversation      Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  communicationLine CommunicationLine? @relation(fields: [communicationLineId], references: [id], onDelete: SetNull)

  @@index([flowState])
  @@index([lockedByUserId])
  @@index([communicationLineId])
  @@index([conversationId, flowState])
  @@map("conversation_meta")
}

/// Registro de estado de entrega de mensajes outbound.
model MessageStatus {
  id         String             @id @default(uuid()) @db.Uuid
  messageId  String             @map("message_id") @db.Uuid
  wamid      String             @map("wamid") @db.VarChar(255)
  status     MessageStatusValue
  errorCode  Int?               @map("error_code")
  errorTitle String?            @map("error_title") @db.VarChar(255)
  timestamp  DateTime
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([wamid])
  @@index([messageId])
  @@map("message_statuses")
}

/// Eventos entrantes del webhook de Meta — inbox queue persistente.
model InboxEvent {
  batchGeneration Int?             @map("batch_generation")
  ingestedAt      DateTime?        @map("ingested_at") @db.Timestamptz(6)
  messageId       String?          @map("message_id") @db.Uuid
  correlationId   String?          @map("correlation_id") @db.VarChar(255)
  id             String           @id @default(uuid()) @db.Uuid
  wamid          String           @unique @map("wamid") @db.VarChar(255) // dedupe key
  phone          String           @db.VarChar(30)
  payload        Json             @db.JsonB
  status         InboxEventStatus @default(pending)
  retryCount     Int              @default(0) @map("retry_count")
  lastErrorAt    DateTime?        @map("last_error_at") @db.Timestamptz(6)
  lastError      String?          @map("last_error") @db.Text
  lockedAt       DateTime?        @map("locked_at") @db.Timestamptz(6)
  lockedBy       String?          @map("locked_by") @db.VarChar(255)
  idempotencyKey String?          @map("idempotency_key") @db.VarChar(255)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt    DateTime?        @map("processed_at") @db.Timestamptz(6)

  @@index([phone])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([messageId])
  @@index([phone, batchGeneration, status])
  @@map("inbox_events")
}

/// Ventana de batching durable por teléfono.
model BatchWindow {
  phone           String    @id @db.VarChar(30)
  batchGeneration Int       @default(0) @map("batch_generation")
  batchReadyAt    DateTime? @map("batch_ready_at") @db.Timestamptz(6)
  windowOpenedAt  DateTime? @map("window_opened_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([batchReadyAt, batchGeneration])
  @@map("batch_windows")
}

/// Historial de claims para ventanas de batching.
model BatchWindowClaim {
  phone             String    @map("phone") @db.VarChar(30)
  batchGeneration   Int       @map("batch_generation")
  claimToken        String?   @map("claim_token") @db.VarChar(64)
  claimLeaseUntil   DateTime? @map("claim_lease_until") @db.Timestamptz(6)
  drainBoundary     DateTime? @map("drain_boundary") @db.Timestamptz(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([phone, batchGeneration])
  @@index([claimLeaseUntil, completedAt])
  @@index([phone, completedAt, batchGeneration])
  @@map("batch_window_claims")
}

/// Cola de eventos salientes — outbox pattern para garantizar entrega a Meta API.
model OutboxEvent {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String?           @map("conversation_id") @db.Uuid
  phone          String            @db.VarChar(30)
  payload        Json              @db.JsonB
  status         OutboxEventStatus @default(pending)
  retryCount     Int               @default(0) @map("retry_count")
  nextRetryAt    DateTime?         @map("next_retry_at") @db.Timestamptz(6)
  lastError      String?           @map("last_error") @db.Text
  lockedAt       DateTime?         @map("locked_at") @db.Timestamptz(6)
  lockedBy       String?           @map("locked_by") @db.VarChar(255)
  wamid          String?           @map("wamid") @db.VarChar(255) // id retornado por Meta
  idempotencyKey String            @unique @map("idempotency_key") @db.VarChar(255)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt         DateTime?         @map("sent_at") @db.Timestamptz(6)

  @@index([phone])
  @@index([status, nextRetryAt])
  @@index([conversationId])
  @@map("outbox_events")
}

/// Durable outbox for critical realtime events.
/// Ensures the event is persisted in the same transaction as the domain change
/// and that the relay delivers it at least once via Redis/Socket.IO.
model RealtimeOutboxEvent {
  id              String               @id @default(uuid()) @db.Uuid
  eventType       String               @map("event_type") @db.VarChar(100)
  socketEventName String               @map("socket_event_name") @db.VarChar(100)
  payload         Json                 @db.JsonB
  status          RealtimeOutboxStatus @default(pending)
  attempts        Int                  @default(0)
  nextRetryAt     DateTime?            @map("next_retry_at") @db.Timestamptz(6)
  lockedAt        DateTime?            @map("locked_at") @db.Timestamptz(6)
  lockedBy        String?              @map("locked_by") @db.VarChar(255)
  publishedAt     DateTime?            @map("published_at") @db.Timestamptz(6)
  lastError       String?              @map("last_error") @db.Text
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, nextRetryAt])
  @@index([eventType])
  @@index([createdAt])
  @@map("realtime_outbox_events")
}

/// Notificaciones del centro de notificaciones del panel admin.
/// Proyección del stream de eventos realtime durable (at-least-once):
/// el subscriber de la API persiste una fila por evento que derivaría un
/// `admin.notification`. Idempotente por `eventId` — los redeliveries de
/// Pub/Sub no duplican filas.
model Notification {
  communicationLineId String? @map("communication_line_id") @db.Uuid
  ticketId       String?  @map("ticket_id") @db.Uuid
  id             String   @id @default(uuid()) @db.Uuid
  eventId        String   @unique @map("event_id") @db.Uuid
  type           String   @db.VarChar(100)
  conversationId String?  @map("conversation_id") @db.Uuid
  contactName    String?  @map("contact_name") @db.Text
  phone          String?  @db.Text
  messagePreview String?  @map("message_preview") @db.Text
  flowState      String?  @map("flow_state") @db.Text
  channel        String?  @db.Text
  priority       String?  @db.Text
  departmentSlug String?  @map("department_slug") @db.Text
  assignedUserId String?  @map("assigned_user_id") @db.Uuid
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([occurredAt])
  @@index([createdAt, id])
  @@map("notifications")
}

/// Log de todos los webhooks recibidos de Meta (para auditoría y replay).
model WebhookEventLog {
  id            String   @id @default(uuid()) @db.Uuid
  correlationId String   @map("correlation_id") @db.VarChar(255)
  rawPayload    Json     @map("raw_payload") @db.JsonB
  signature     String?  @db.VarChar(255)
  processedOk   Boolean  @default(false) @map("processed_ok")
  errorMessage  String?  @map("error_message") @db.Text
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([correlationId])
  @@index([createdAt])
  @@index([processedOk, createdAt])
  @@map("webhook_event_logs")
}

/// Departamentos disponibles para enrutamiento de conversaciones.
model Department {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique @db.VarChar(100)
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  serviceHours    String?  @map("service_hours") @db.VarChar(255) // horario legible (display)
  serviceSchedule Json?    @map("service_schedule") // horario estructurado legacy/sincronizado para IA
  isActive        Boolean  @default(true) @map("is_active")
  keywords        String[] @default([]) @db.Text // para routing automático
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  schedules          DepartmentSchedule[]
  scheduleExceptions DepartmentScheduleException[]

  @@index([slug])
  @@index([isActive])
  @@map("departments")
}

enum DepartmentDayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("department_day_of_week")
}

enum DepartmentScheduleExceptionType {
  PARTIALLY_OPEN
  PARTIALLY_CLOSED
  FULLY_CLOSED

  @@map("department_schedule_exception_type")
}

enum DepartmentExceptionRecurrenceType {
  NONE
  YEARLY
  WEEKLY
  SPECIFIC_WEEKDAYS

  @@map("department_exception_recurrence_type")
}

model DepartmentSchedule {
  id           String              @id @default(uuid()) @db.Uuid
  departmentId String              @map("department_id") @db.Uuid
  dayOfWeek    DepartmentDayOfWeek @map("day_of_week")
  isOpen       Boolean             @default(false) @map("is_open")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  department Department                   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  intervals  DepartmentScheduleInterval[]

  @@unique([departmentId, dayOfWeek], map: "uq_department_schedules_department_day")
  @@index([departmentId])
  @@index([dayOfWeek])
  @@map("department_schedules")
}

model DepartmentScheduleInterval {
  id         String   @id @default(uuid()) @db.Uuid
  scheduleId String   @map("schedule_id") @db.Uuid
  startTime  String   @map("start_time") @db.VarChar(5)
  endTime    String   @map("end_time") @db.VarChar(5)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  schedule DepartmentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, startTime, endTime], map: "uq_department_schedule_intervals_range")
  @@index([scheduleId, sortOrder])
  @@map("department_schedule_intervals")
}

model DepartmentScheduleException {
  id                 String                            @id @default(uuid()) @db.Uuid
  departmentId       String                            @map("department_id") @db.Uuid
  type               DepartmentScheduleExceptionType
  recurrenceType     DepartmentExceptionRecurrenceType @default(NONE) @map("recurrence_type")
  startDate          DateTime?                         @map("start_date") @db.Date
  endDate            DateTime?                         @map("end_date") @db.Date
  recurrenceStartsOn DateTime?                         @map("recurrence_starts_on") @db.Date
  recurrenceEndsOn   DateTime?                         @map("recurrence_ends_on") @db.Date
  yearlyStartMonth   Int?                              @map("yearly_start_month")
  yearlyStartDay     Int?                              @map("yearly_start_day")
  yearlyEndMonth     Int?                              @map("yearly_end_month")
  yearlyEndDay       Int?                              @map("yearly_end_day")
  weeklyAnchorDate   DateTime?                         @map("weekly_anchor_date") @db.Date
  weekdays           DepartmentDayOfWeek[]             @default([])
  reason             String?                           @db.VarChar(500)
  createdAt          DateTime                          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(6)

  department Department                    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  intervals  DepartmentExceptionInterval[]

  @@index([departmentId])
  @@index([departmentId, recurrenceType])
  @@index([departmentId, startDate, endDate])
  @@index([departmentId, recurrenceStartsOn, recurrenceEndsOn])
  @@index([departmentId, yearlyStartMonth, yearlyStartDay, yearlyEndMonth, yearlyEndDay])
  @@map("department_schedule_exceptions")
}

model DepartmentExceptionInterval {
  id          String   @id @default(uuid()) @db.Uuid
  exceptionId String   @map("exception_id") @db.Uuid
  startTime   String   @map("start_time") @db.VarChar(5)
  endTime     String   @map("end_time") @db.VarChar(5)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  exception DepartmentScheduleException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)

  @@unique([exceptionId, startTime, endTime], map: "uq_department_exception_intervals_range")
  @@index([exceptionId, sortOrder])
  @@map("department_exception_intervals")
}

// ── Eventos ciudadanos ────────────────────────────────────────────────────────

enum EventStatus {
  draft
  published
  completed
  cancelled

  @@map("event_status")
}

enum EventType {
  townhall
  community
  volunteer
  campaign
  rally

  @@map("event_type")
}

enum EventVisibility {
  public
  private

  @@map("event_visibility")
}

enum RegistrationStatus {
  invited
  registered
  confirmed
  cancelled
  waitlist

  @@map("registration_status")
}

enum AttendanceStatus {
  pending
  attended
  no_show

  @@map("attendance_status")
}

/// Evento ciudadano organizado por el panel administrativo.
model Event {
  id              String      @id @default(uuid()) @db.Uuid
  title           String      @db.VarChar(255)
  slug            String      @unique @db.VarChar(255)
  description     String?     @db.Text
  eventType       EventType   @default(townhall) @map("event_type")
  status          EventStatus @default(draft)
  visibility      EventVisibility @default(public)
  startsAt        DateTime    @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime?   @map("ends_at") @db.Timestamptz(6)
  locationName    String?     @map("location_name") @db.VarChar(255)
  neighborhood    String?     @db.VarChar(255)
  address         String?     @db.VarChar(500)
  latitude        Decimal?    @db.Decimal(10, 7)
  longitude       Decimal?    @db.Decimal(10, 7)
  capacity        Int?
  organizerUserId String?     @map("organizer_user_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organizer     User?               @relation("EventOrganizer", fields: [organizerUserId], references: [id], onDelete: SetNull)
  registrations EventRegistration[]
  checkins      EventCheckin[]

  @@index([status])
  @@index([startsAt])
  @@index([visibility, status, startsAt], map: "idx_events_visibility_status_starts_at")
  @@index([visibility, startsAt], map: "idx_events_visibility_starts_at")
  @@index([organizerUserId])
  @@map("events")
}

/// Registro de un ciudadano a un evento (RSVP + asistencia).
/// Un ciudadano solo puede tener un registro por evento.
model EventRegistration {
  id                 String             @id @default(uuid()) @db.Uuid
  eventId            String             @map("event_id") @db.Uuid
  citizenId          String             @map("citizen_id") @db.Uuid
  registrationStatus RegistrationStatus @default(registered) @map("registration_status")
  attendanceStatus   AttendanceStatus   @default(pending) @map("attendance_status")
  checkedInAt        DateTime?          @map("checked_in_at") @db.Timestamptz(6)
  sourceChannel      SourceChannel      @default(web) @map("source_channel")
  notes              String?            @db.Text
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  citizen  Citizen        @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  checkins EventCheckin[]

  @@unique([eventId, citizenId], map: "uq_event_registrations_event_citizen")
  @@index([eventId])
  @@index([citizenId])
  @@index([registrationStatus])
  @@map("event_registrations")
}

/// Trazabilidad de check-ins para un registro de evento.
/// Permite múltiples check-ins por registro (reintentos/correcciones de staff).
model EventCheckin {
  id             String   @id @default(uuid()) @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  registrationId String   @map("registration_id") @db.Uuid
  checkedInBy    String?  @map("checked_in_by") @db.Uuid
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event           Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration    EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  checkedInByUser User?             @relation("EventCheckinByUser", fields: [checkedInBy], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([registrationId])
  @@map("event_checkins")
}

/// Asignaciones de conversaciones a agentes humanos.
model Assignment {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  departmentSlug String?   @map("department_slug") @db.VarChar(100)
  assignedAt     DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  releasedAt     DateTime? @map("released_at") @db.Timestamptz(6)
  isActive       Boolean   @default(true) @map("is_active")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([userId])
  @@index([isActive])
  @@map("assignments")
}

model CommunicationLine {
