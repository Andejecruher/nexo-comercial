// ── Módulo de Tickets ciudadanos ──────────────────────────────────────────────

/// Estado del caso (ticket). Un ticket se cierra/resuelve de forma independiente
/// de la conversación: la entidad del ciudadano permanece abierta y reutilizable.
enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("ticket_status")
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("ticket_priority")
}

enum TicketSource {
  WHATSAPP
  WEB
  OTHER

  @@map("ticket_source")
}

enum TicketActorType {
  CITIZEN
  AGENT
  BOT
  SYSTEM

  @@map("ticket_actor_type")
}

enum NewsletterSubscriberStatus {
  pending
  active
  unsubscribed

  @@map("newsletter_subscriber_status")
}

/// Suscripciones al boletín (sitio público). Independiente del CRM Citizen.
model NewsletterSubscriber {
  id                    String                     @id @default(uuid()) @db.Uuid
  email                 String                     @unique @db.VarChar(255)
  name                  String?                    @db.VarChar(255)
  status                NewsletterSubscriberStatus @default(pending)
  source                String                     @db.VarChar(50)
  subscribedAt          DateTime?                  @map("subscribed_at") @db.Timestamptz(6)
  unsubscribedAt        DateTime?                  @map("unsubscribed_at") @db.Timestamptz(6)
  ipAddress             String?                    @map("ip_address") @db.VarChar(45)
  confirmTokenHash      String?                    @map("confirm_token_hash") @db.VarChar(64)
  confirmTokenExpiresAt DateTime?                  @map("confirm_token_expires_at") @db.Timestamptz(6)
  unsubscribeTokenHash  String?                    @map("unsubscribe_token_hash") @db.VarChar(64)
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([confirmTokenHash])
  @@index([unsubscribeTokenHash])
  @@map("newsletter_subscribers")
}

/// Caso de atención ciudadana dentro de una Conversation.
/// Una conversación puede tener múltiples tickets históricos pero solo 1 activo (OPEN | IN_PROGRESS).
/// Ticket = caso/trámite dentro del historial de una conversación (1:N).
/// Máximo UN ticket activo (OPEN | IN_PROGRESS) por conversación — árbito:
/// índice único parcial uq_tickets_one_active_per_conversation. Al cerrarse, el
/// siguiente mensaje del ciudadano abre un ticket nuevo. La asociación
/// Message <-> Ticket se modela vía TicketMessage (aislamiento por ticket).
model Ticket {
  id               String         @id @default(uuid()) @db.Uuid
  conversationId   String         @map("conversation_id") @db.Uuid
  citizenId        String         @map("citizen_id") @db.Uuid
  /// Folio legible único: YYYYMMDDHHMMSS_XXXX_YYYY (timestamp UTC + últimos 4 de
  /// la línea de plataforma + últimos 4 del teléfono del ciudadano).
  folio            String         @unique @db.VarChar(32)
  status           TicketStatus   @default(OPEN)
  priority         TicketPriority @default(MEDIUM)
  source           TicketSource   @default(WHATSAPP)
  title            String?        @db.VarChar(255)
  description      String?        @db.Text
  departmentSlug   String?        @map("department_slug") @db.VarChar(100)
  assignedUserId   String?        @map("assigned_user_id") @db.Uuid
  closeReason      String?        @map("close_reason") @db.VarChar(50)
  closeSummary     String?        @map("close_summary") @db.Text
  escalationReason String?        @map("escalation_reason") @db.VarChar(500)
  closedAt         DateTime?      @map("closed_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  citizen      Citizen      @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  assignedUser User?        @relation("TicketAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  ticketMessages TicketMessage[]
  messages       Message[]      @relation("MessageTicket")

  /// Conversaciones que tienen este ticket como activo (a lo sumo una).
  activeInConversation Conversation[] @relation("ConversationActiveTicket")

  @@index([conversationId, status])
  @@index([citizenId])
  @@index([assignedUserId])
  @@index([status])
  /// Soporte de la paginación por offset del dashboard (orden determinista).
  @@index([updatedAt, id])
  @@index([status, updatedAt, id])
  @@index([departmentSlug, updatedAt, id])
  @@index([assignedUserId, updatedAt, id])
  @@map("tickets")
}

/// Asociación entre un Ticket y un Message del historial de conversación.
/// Permite rastrear qué mensajes pertenecen a cada ticket.
/// Idempotente: única por (ticketId, messageId).
model TicketMessage {
  id        String          @id @default(uuid()) @db.Uuid
  ticketId  String          @map("ticket_id") @db.Uuid
  messageId String          @map("message_id") @db.Uuid
  actorType TicketActorType @default(CITIZEN) @map("actor_type")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket  Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message Message @relation("MessageTickets", fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([ticketId, messageId], map: "uq_ticket_messages_ticket_message")
  @@index([ticketId])
  @@index([messageId])
  @@map("ticket_messages")
}

model AiToolCall {
  id            String           @id @default(uuid()) @db.Uuid
  runId         String           @map("run_id") @db.Uuid
  toolId        String           @map("tool_id") @db.Uuid
  toolName      String           @map("tool_name") @db.VarChar(120)
  status        AIToolCallStatus @default(running)
  inputPayload  Json             @default("{}") @map("input_payload") @db.JsonB
  outputPayload Json?            @map("output_payload") @db.JsonB
  errorMessage  String?          @map("error_message") @db.Text
  durationMs    Int?             @map("duration_ms")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt    DateTime?        @map("finished_at") @db.Timestamptz(6)

  run  AiRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  tool AiTool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([toolId])
  @@index([status])
  @@map("ai_tool_calls")
}

